generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// --- Users & Auth ---

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alertRules AlertRule[]
}

// --- WhatsApp Sessions ---

enum SessionStatus {
  CONNECTED
  CONNECTING
  DISCONNECTED
  DEGRADED
  REQUIRES_REAUTH
}

model Session {
  id                String        @id @default(uuid())
  name              String
  phoneNumber       String?       @unique
  status            SessionStatus @default(DISCONNECTED)
  lastConnected     DateTime?
  lastError         String?
  reconnectAttempts Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  targets  Target[]
  authKeys AuthKey[]
}

model AuthKey {
  id        String  @id @default(uuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String
  keyId     String
  value     Json

  @@unique([sessionId, type, keyId])
  @@index([sessionId, type])
}

// --- Monitored Targets ---

enum PresenceStatus {
  ONLINE
  LIKELY_ONLINE
  UNCERTAIN
  LIKELY_OFFLINE
  OFFLINE
}

model Target {
  id          String         @id @default(uuid())
  jid         String         @unique
  phoneNumber String
  label       String?
  sessionId   String
  session     Session        @relation(fields: [sessionId], references: [id])
  isActive    Boolean        @default(true)
  status      PresenceStatus @default(OFFLINE)
  confidence  Float          @default(0)
  lastSeen    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  presenceEvents      PresenceEvent[]
  rttProbes           RttProbe[]
  statusSnapshots     StatusSnapshot[]
  alertRules          AlertRule[]
  interceptedMessages InterceptedMessage[]
  callEvents          CallEvent[]
  groupActivities     GroupActivity[]
  profileChanges      ProfileChange[]
}

// --- Detection Events ---

enum PresenceState {
  AVAILABLE
  UNAVAILABLE
  COMPOSING
  RECORDING
  PAUSED
}

model PresenceEvent {
  id        String        @id @default(uuid())
  targetId  String
  target    Target        @relation(fields: [targetId], references: [id], onDelete: Cascade)
  state     PresenceState
  timestamp DateTime      @default(now())
  raw       Json?

  @@index([targetId, timestamp])
  @@index([timestamp])
}

enum RttClassification {
  ACTIVE
  STANDBY
  OFFLINE
}

model RttProbe {
  id             String            @id @default(uuid())
  targetId       String
  target         Target            @relation(fields: [targetId], references: [id], onDelete: Cascade)
  rttMs          Int?
  movingAvg      Float?
  medianRtt      Float?
  classification RttClassification
  timestamp      DateTime          @default(now())

  @@index([targetId, timestamp])
  @@index([timestamp])
}

model StatusSnapshot {
  id         String         @id @default(uuid())
  targetId   String
  target     Target         @relation(fields: [targetId], references: [id], onDelete: Cascade)
  status     PresenceStatus
  confidence Float
  signals    Json
  reasoning  String
  timestamp  DateTime       @default(now())

  @@index([targetId, timestamp])
  @@index([timestamp])
}

// --- Intercepted Messages ---

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  VOICE_NOTE
  DOCUMENT
  STICKER
  LOCATION
  CONTACT
  POLL
  REACTION
  UNKNOWN
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

model InterceptedMessage {
  id           String           @id @default(uuid())
  targetId     String
  target       Target           @relation(fields: [targetId], references: [id], onDelete: Cascade)
  waMessageId  String           // WhatsApp message ID
  type         MessageType
  direction    MessageDirection
  senderJid    String           // Who sent it
  chatJid      String           // Conversation/group JID
  content      String?          // Text content or caption
  timestamp    DateTime
  isForwarded  Boolean          @default(false)
  isViewOnce   Boolean          @default(false)
  isDeleted    Boolean          @default(false)
  deletedAt    DateTime?
  quotedMsgId  String?          // ID of replied-to message
  mentions     Json?            // Array of mentioned JIDs
  raw          Json?            // Raw message data

  media        MediaFile?
  location     LocationData?

  @@unique([targetId, waMessageId])
  @@index([targetId, timestamp])
  @@index([chatJid, timestamp])
  @@index([timestamp])
  @@index([type])
}

// --- Media Files ---

model MediaFile {
  id          String             @id @default(uuid())
  messageId   String             @unique
  message     InterceptedMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mimeType    String
  fileName    String?
  fileSize    Int?               // in bytes
  thumbnailB64 String?           // Base64 encoded thumbnail
  filePath    String?            // Local storage path
  duration    Int?               // Audio/video duration in seconds
  width       Int?
  height      Int?
  createdAt   DateTime           @default(now())

  @@index([mimeType])
}

// --- Location Data ---

model LocationData {
  id          String             @id @default(uuid())
  messageId   String             @unique
  message     InterceptedMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  latitude    Float
  longitude   Float
  name        String?            // Location name
  address     String?            // Full address
  url         String?            // Google Maps URL
  createdAt   DateTime           @default(now())
}

// --- Call Events ---

enum CallType {
  VOICE
  VIDEO
}

enum CallStatus {
  OFFER
  RINGING
  ACCEPTED
  REJECTED
  TIMEOUT
  TERMINATED
  MISSED
}

model CallEvent {
  id          String     @id @default(uuid())
  targetId    String
  target      Target     @relation(fields: [targetId], references: [id], onDelete: Cascade)
  waCallId    String     // WhatsApp call ID
  callerJid   String
  callType    CallType
  status      CallStatus
  isGroup     Boolean    @default(false)
  groupJid    String?
  duration    Int?       // Call duration in seconds
  timestamp   DateTime
  raw         Json?

  @@index([targetId, timestamp])
  @@index([timestamp])
}

// --- Group Activity ---

enum GroupEventType {
  CREATED
  SUBJECT_CHANGED
  DESCRIPTION_CHANGED
  ICON_CHANGED
  SETTINGS_CHANGED
  PARTICIPANT_ADDED
  PARTICIPANT_REMOVED
  PARTICIPANT_PROMOTED
  PARTICIPANT_DEMOTED
  INVITE_LINK_RESET
}

model GroupActivity {
  id          String         @id @default(uuid())
  targetId    String
  target      Target         @relation(fields: [targetId], references: [id], onDelete: Cascade)
  groupJid    String
  groupName   String?
  eventType   GroupEventType
  actorJid    String?        // Who performed the action
  affectedJid String?        // Who was affected
  detail      String?        // Additional detail text
  timestamp   DateTime
  raw         Json?

  @@index([targetId, timestamp])
  @@index([groupJid, timestamp])
  @@index([timestamp])
}

// --- Profile Changes ---

model ProfileChange {
  id          String   @id @default(uuid())
  targetId    String
  target      Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  changeType  String   // 'picture', 'status', 'name', 'bio'
  oldValue    String?
  newValue    String?
  filePath    String?  // For profile picture changes
  timestamp   DateTime @default(now())

  @@index([targetId, timestamp])
  @@index([timestamp])
}

// --- Alerts ---

enum AlertType {
  CAME_ONLINE
  WENT_OFFLINE
  LONG_SESSION
  UNUSUAL_HOUR
  NEW_MESSAGE
  INCOMING_CALL
  LOCATION_SHARED
  MESSAGE_DELETED
}

enum AlertChannel {
  WEBHOOK
  WEBSOCKET
}

model AlertRule {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  targetId    String
  target      Target       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  triggerOn   AlertType
  channel     AlertChannel @default(WEBSOCKET)
  destination String       @default("")
  isActive    Boolean      @default(true)
  cooldownMin Int          @default(5)
  lastFired   DateTime?
  createdAt   DateTime     @default(now())
}
