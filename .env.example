# GO CONTROLE v2 - Configuration

# Database
DATABASE_URL="postgresql://gocontrole:gocontrole_secret@localhost:5432/gocontrole?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# JWT
JWT_SECRET=change-this-to-a-strong-secret-key
JWT_EXPIRES_IN=24h

# Admin account (created on first start)
ADMIN_EMAIL=admin@gocontrole.local
ADMIN_PASSWORD=admin123

# Detection tuning
PRESENCE_RESUBSCRIBE_INTERVAL_MS=240000
PRESENCE_POLL_INTERVAL_MS=30000
RTT_PROBE_INTERVAL_MS=8000
RTT_TIMEOUT_MS=10000
CONFIDENCE_THRESHOLD_ONLINE=70
STATUS_HYSTERESIS_MS=15000

# Logging
LOG_LEVEL=info

# API PISTE (gouv.fr) — Plateforme d'Intermediation des Services de l'Etat
# Register at https://piste.gouv.fr to obtain credentials
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
PISTE_SANDBOX=true
